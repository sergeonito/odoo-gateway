# Copy with `make env` (fills in a random dev secret). Never commit .env.
GATEWAY_ENVIRONMENT=local

# Odoo from docker-compose. `admin`/`admin` only until `make odoo-setup && make odoo-apikey`
# has created the least-privileged integration user; then login=gateway and its API key.
GATEWAY_ODOO_URL=http://localhost:8069
GATEWAY_ODOO_DB=odoo
GATEWAY_ODOO_LOGIN=admin
GATEWAY_ODOO_API_KEY=admin

GATEWAY_DATABASE_URL=postgresql+asyncpg://gateway:gateway@localhost:5433/gateway

# Celery broker and the stock snapshot period in seconds (30..86400)
GATEWAY_REDIS_URL=redis://localhost:6379/0
GATEWAY_SNAPSHOT_INTERVAL_S=900

# dev = tokens signed by the gateway (`make token`); entra = Microsoft Entra ID
GATEWAY_AUTH_MODE=dev
GATEWAY_DEV_JWT_SECRET=change-me
GATEWAY_JWT_AUDIENCE=odoo-gateway

# GATEWAY_AUTH_MODE=entra
# GATEWAY_ENTRA_TENANT_ID=
# GATEWAY_ENTRA_CLIENT_ID=
# GATEWAY_ENTRA_ROLE_MAP={"Gateway.Viewer":"viewer","Gateway.Operator":"operator","Gateway.Admin":"admin"}
